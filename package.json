{
  "name": "everest-local-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web && node scripts/write-build-info.mjs && node scripts/verify-web-export.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit": "node scripts/static-audit.mjs",
    "audit:migrations": "node scripts/migration-audit.mjs",
    "test:security": "node --test tests/security-invariants.test.mjs tests/quote-authority.test.mjs tests/cart-authority.test.mjs tests/cart-integrity.test.mjs tests/delivery-request-integrity.test.mjs tests/inventory-integrity.test.mjs tests/commerce-financial-integrity.test.mjs tests/admin-mfa-integrity.test.mjs tests/trigger-security.test.mjs tests/settings-preferences.test.mjs tests/social-discovery-security.test.mjs tests/social-messaging-ux-fix.test.mjs tests/production-messaging-overhaul.test.mjs tests/final-messaging-mobile-qa.test.mjs tests/messaging-motion-interactions.test.mjs tests/iphone-chat-interaction-final.test.mjs tests/iphone-chat-rendered-dom-regression.test.mjs tests/dual-role-workspace.test.mjs tests/request-posts-ux.test.mjs tests/global-local-crm-p0.test.mjs tests/professional-crm-v2.test.mjs tests/customer-experience-job-portal.test.mjs",
    "test:business-verification": "node --experimental-strip-types --test tests/business-verification.test.mjs",
    "test:dispatch": "node --test tests/service-aware-dispatch.test.mjs",
    "test:external": "node --test tests/external-flow.test.mjs",
    "test:home-shell": "node --test tests/edge-home-quick-actions.test.mjs",
    "test:products": "node --test tests/product-marketplace-commerce.test.mjs",
    "test:request-posts": "node --test tests/request-posts-ux.test.mjs",
    "test:crm": "node --test tests/global-local-crm-p0.test.mjs tests/professional-crm-v2.test.mjs tests/crm-integrations-automation.test.mjs",
    "test:integrations": "node --test tests/crm-integrations-automation.test.mjs tests/customer-calendar-integration.test.mjs",
    "test:experience": "node --test tests/adaptive-experience-modes.test.mjs",
    "test:launch": "node --test tests/launch-payment-entitlement-hardening.test.mjs",
    "test:contact-import": "node --test tests/contact-import.test.mjs",
    "test:retention": "node --test tests/retention-p0.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "zod": "^3.25.76",
    "expo-quick-actions": "6.0.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo-location": "~19.0.8",
    "expo-calendar": "~15.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "typescript-eslint": "^8.39.0"
  }
}
