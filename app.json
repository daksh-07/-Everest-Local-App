{
  "expo": {
    "name": "Everest Local",
    "slug": "everest-local",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "everestlocal",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.everestlocal.app",
      "backgroundColor": "#0b0b0b"
    },
    "android": {
      "package": "com.everestlocal.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Everest Local uses photos you choose for service requests, posts, products, profile images and verification.",
          "cameraPermission": "Everest Local uses the camera only when you choose to capture media for supported features.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Everest Local uses your location only when you choose it to confirm where a local service is needed."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://bmwbljefnamvjnmuvkvv.supabase.co",
      "supabaseAnonKey": "sb_publishable_evkp_gHdu3ucFI82P8VLCw_vCjR2M2S"
    },
    "backgroundColor": "#0b0b0b"
  }
}
