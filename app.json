{
  "expo": {
    "name": "Everest Local",
    "slug": "everest-local",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "everestlocal",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.everestlocal.app",
      "backgroundColor": "#0b0b0b",
      "infoPlist": {},
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.everestlocal.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0b",
        "monochromeImage": "./assets/notification-icon.png"
      },
      "icon": "./assets/icon.png",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Everest Local uses photos you choose for service requests, posts, products, profile images and verification.",
          "cameraPermission": "Everest Local uses the camera only when you choose to capture media for supported features.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Everest Local uses your location only when you choose it to confirm where a local service is needed."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Everest Local uses your calendar only when you choose to check availability or add confirmed Everest bookings."
        }
      ],
      "expo-iap",
      [
        "expo-audio",
        {
          "microphonePermission": "Everest Local uses your microphone only when you choose to record a voiceover or original sound."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "everest-live",
          "color": "#E6C890",
          "mode": "production",
          "enableBackgroundRemoteNotifications": false,
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://bmwbljefnamvjnmuvkvv.supabase.co",
      "supabaseAnonKey": "sb_publishable_evkp_gHdu3ucFI82P8VLCw_vCjR2M2S"
    },
    "backgroundColor": "#0b0b0b",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b0b"
    }
  }
}
