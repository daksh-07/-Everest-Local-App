{
  "expo": {
    "name": "Everest Local",
    "slug": "everest-local",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "everestlocal",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.everestlocal.app"
    },
    "android": {
      "package": "com.everestlocal.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Everest Local uses your photos to verify driver documents and vehicle images.",
          "cameraPermission": "Everest Local uses your camera to verify driver documents and vehicle images.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
