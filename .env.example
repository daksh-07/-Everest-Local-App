# Public mobile configuration only. Never place service-role keys or secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=development

# Trusted server / Supabase Edge Function configuration. Never bundle these into Expo.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required server-side recurring monthly Stripe Price ID for Everest Pro.
STRIPE_EVEREST_PRO_PRICE_ID=
AI_API_URL=
AI_MODEL=
AI_API_KEY=
STORAGE_CONFIG=
NOTIFICATION_CONFIG=

# Server-only calendar integration secrets (Supabase Edge Functions; never expose to Expo clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INTEGRATION_OAUTH_STATE_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# OAuth callback registered with Google. Customer Calendar currently shares the
# CRM callback so a signed callback state can route the connection safely.
CRM_INTEGRATION_CALLBACK_URL=
# Public application origin used after provider OAuth completes
APP_PUBLIC_URL=

# Apple App Store Server API (Everest Pro iOS subscriptions)
# Create an In-App Purchase key in App Store Connect. Keep the .p8 private key server-only.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.everestlocal.app
