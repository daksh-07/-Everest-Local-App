# Public mobile configuration only. Never place service-role keys or secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=development

# Trusted server / Supabase Edge Function configuration. Never bundle these into Expo.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_API_URL=
AI_MODEL=
AI_API_KEY=
STORAGE_CONFIG=
NOTIFICATION_CONFIG=

# Server-only calendar integration secrets (Supabase Edge Functions; never expose to Expo clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INTEGRATION_OAUTH_STATE_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# Optional. Defaults to <SUPABASE_URL>/functions/v1/customer-calendar-oauth
CUSTOMER_CALENDAR_CALLBACK_URL=
# Public application origin used after provider OAuth completes
APP_PUBLIC_URL=
