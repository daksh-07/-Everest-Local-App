# Public mobile configuration only. Never place service-role keys or secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=development

# Trusted server / Supabase Edge Function configuration. Never bundle these into Expo.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Trusted server-side HTTPS origin serving /orders and /bookings (no trailing path).
CHECKOUT_APP_ORIGIN=
AI_API_URL=
AI_MODEL=
AI_API_KEY=
STORAGE_CONFIG=
NOTIFICATION_CONFIG=
