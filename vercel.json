{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/phase5b-live-operations-ux": false,
      "codex/phase5-discovery-core-ux": false,
      "codex/phase6-backend-hardening": false
    }
  }
}
